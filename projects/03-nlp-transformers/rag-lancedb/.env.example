# Azure Storage Configuration Template
# Copy this file to .env and fill in your actual credentials
# .env is in .gitignore and will NOT be committed to Git

# Azure Storage Account Name
AZURE_STORAGE_ACCOUNT=your-storage-account-name

# Azure Storage Container Name
AZURE_STORAGE_CONTAINER=your-container-name

# Azure Storage SAS Token (recommended for limited access)
AZURE_STORAGE_SAS_TOKEN=your-sas-token-here

# OR use Account Key (full access - less secure)
# AZURE_STORAGE_KEY=your-account-key-here

# Azure OpenAI Configuration (optional)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-openai-key-here

# ============================================================================
# SETUP INSTRUCTIONS:
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual credentials in .env
# 3. Never commit .env to Git (it's in .gitignore)
# 4. See ADLS_SETUP_GUIDE.md for getting credentials
