# ============================================================================
# Security: Prevent committing sensitive credentials
# ============================================================================

# Environment variables with credentials
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# LanceDB local storage
lancedb/
*.lance

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Test outputs
test_output/
*.tmp

# Azure credentials (extra safety)
*.pem
*.key
*credentials*
*secrets*

# ============================================================================
# What IS committed (safe files):
# ============================================================================
# .env.example - Template without real credentials ✅
# *.py - Source code ✅
# *.md - Documentation ✅
# requirements.txt - Dependencies ✅
